# SevaNest Web Admin Portal - Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys, production credentials, or sensitive tokens.

# Base URL for the SevaNest API Backend (Required)
# Deployed backend API base path: https://sevanest-backend.onrender.com/api/v1
# For local development with Vite reverse proxy: /api/v1
VITE_API_BASE_URL=https://sevanest-backend.onrender.com/api/v1

# Environment Name (development | staging | production | test)
VITE_APP_ENV=development

# Authentication Mode: set to 'true' for offline in-memory development mock; 'false' for live backend API
VITE_USE_MOCK_AUTH=false

# Request timeout in milliseconds (Default: 15000)
VITE_API_TIMEOUT_MS=15000

# Telemetry / Error Reporting (Pending vendor tool confirmation)
VITE_ENABLE_TELEMETRY=false

